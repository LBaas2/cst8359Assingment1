@model Assignment1.Models.Event

@{
    ViewData["Title"] = Model.title;
}

<h1 class="display-6 fw-normal mb-3">@Model.title</h1>

@if (!string.IsNullOrEmpty(Model.bannerurl))
{
    <div class="mb-3 text-start">
        <img src="@Model.bannerurl" alt="@Model.title Banner" class="img-fluid d-block" style="max-height: 450px;" />
    </div>
}


<p class="mb-3">
    <strong>Description:</strong> @Model.description
</p>

<p class="mb-3">
    <strong>Date:</strong> @Model.date.ToString("yyyy-MM-dd h:mm:ss tt")
</p>

<p class="mb-4">
    <strong>Location:</strong> @Model.location
</p>

<h2 class="h2 fw-normal mb-2">Attendees</h2>

@if (Model.attendees != null && Model.attendees.Any())
{
    <ul class="mb-4">
        @foreach (var attendee in Model.attendees)
        {
            <li>@attendee.name (@attendee.email)</li>
        }
    </ul>
}
else
{
    <p class="text-muted mb-4">No attendees registered yet.</p>
}

<div class="mt-3">
    <a asp-controller="Event" asp-action="EditEvent" asp-route-id="@Model.id" class="btn btn-secondary me-1">Edit Event</a>
    <a asp-controller="Event" asp-action="ManageAttendee" asp-route-id="@Model.id" class="btn btn-info text-dark me-2">Manage Attendees</a>
    <a asp-controller="Event" asp-action="Index" class="align-middle">Back to List</a>
</div>
