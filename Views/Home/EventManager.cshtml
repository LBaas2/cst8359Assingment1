@model List<Assignment1.Models.Event>
@{
    ViewData["Title"] = "Event Manager";
    Layout = "_Layout";
}

    <h2 class="recipes-title">Event Manager</h2>
    <p>Select an event to manager attendees.</p>
    <div class="events-container">
        <table font-family: arial, sans-serif;
  border-collapse: collapse;
  width: 100%;>
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Location</th>
            </tr>
            @foreach(var events in Model)
            {
                <tr>
                    <td>@events.title</td>
                    <td>@events.date</td>
                    <td>@events.location</td>
                    <td> 
                        <a asp-controller="Home"
                        asp-action="ManageAttendee"
                        asp-route-id="@events.id"
                        class="text-decoration-none text-dark">
                            <div class="card">
                                <div class="card-body">
                                    <p>Manage Attendees</p>
                                </div>
                            </div>
                        </a>
                    </td>
                </tr>
            }
        </table>
    </div>
